  "version": "1.0.0",
  "description": "StaySupply frontend demo",
  "author": "Avinash Pal",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server.cjs",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
